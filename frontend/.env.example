# GrantJudge — copy to .env.local
#
# The DEMO instance: same source as the canonical contract, with the appeal and
# stall windows in minutes rather than days so that a whole round can be watched
# end to end. This is what the app reads and writes.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# The CANONICAL instance: the brief exactly — 24-hour appeal window, 48-hour
# stall window, one round per wallet per hour. Named on the docs page.
NEXT_PUBLIC_CANONICAL_ADDRESS=0x0000000000000000000000000000000000000000

# GrantConsumer — the composability example. Holds no funds, zero payable
# methods. Optional; the docs page links it when it is set.
NEXT_PUBLIC_CONSUMER_ADDRESS=0x0000000000000000000000000000000000000000

NEXT_PUBLIC_GENLAYER_NETWORK=studio-dev
